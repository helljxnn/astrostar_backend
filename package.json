{
    "name": "astrostar_backend",
    "type": "module",
    "scripts": {
        "build": "npx prisma generate",
        "postinstall": "npx prisma generate",
        "dev": "nodemon src/index.js",
        "dev:local": "cross-env NODE_ENV=development nodemon src/index.js",
        "start": "node src/index.js",
        "test:system": "node src/utils/systemTest.js",
        "test:db": "node src/utils/testConnection.js",
        "test:roles": "cross-env NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest --runInBand src/modules/Roles --passWithNoTests",
        "prisma:migrate": "npx prisma migrate dev",
        "prisma:generate": "npx prisma generate",
        "prisma:seed": "npx prisma db seed",
        "roles:sync-base": "node prisma/sync-base-role-permissions.js",
        "prisma:studio": "npx prisma studio",
        "prisma:push": "npx prisma db push",
        "prisma:pull": "npx prisma db pull",
        "prisma:reset": "npx prisma migrate reset",
        "prisma:deploy": "npx prisma migrate deploy",
        "prisma:status": "npx prisma migrate status",
        "db:test": "node src/utils/testConnection.js",
        "seed:master": "node prisma/seed.js",
        "test:registrations": "node src/scripts/testRegistrations.js",
        "security:check": "npm audit --audit-level=high",
        "security:generate-secrets": "node scripts/generate-secrets.js",
        "security:audit": "npm audit",
        "deployment:prepare": "node scripts/prepare-deployment.js",
        "db:fix-local-schema": "node scripts/fix-local-schema-drift.js",
        "events:seed-temp": "node scripts/seed-temporary-client-events.mjs",
        "legacy:import": "node scripts/import-legacy-athletes.mjs",
        "athletes:cleanup": "node scripts/cleanup-athletes-domain.mjs",
        "test": "cross-env NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest --runInBand",
        "test:watch": "cross-env NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest --watch",
        "test:coverage": "cross-env NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest --coverage"
    },
    "prisma": {
        "seed": "node prisma/seed.js"
    },
    "dependencies": {
        "@prisma/client": "^6.19.2",
        "axios": "^1.13.6",
        "bcrypt": "^6.0.0",
        "bcryptjs": "^3.0.2",
        "cloudinary": "^2.8.0",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.5",
        "dotenv": "^17.2.3",
        "express": "^5.1.0",
        "express-rate-limit": "^8.2.1",
        "express-validator": "^7.3.0",
        "helmet": "^8.1.0",
        "joi": "^18.0.2",
        "jsonwebtoken": "^9.0.2",
        "jspdf": "^4.2.1",
        "multer": "^2.0.2",
        "node-cron": "^4.2.1",
        "node-fetch": "^3.3.2",
        "nodemailer": "^8.0.4",
        "pdfkit": "^0.13.0",
        "prisma": "^6.19.2",
        "streamifier": "^0.1.1",
        "swagger-jsdoc": "^6.2.8",
        "swagger-ui-express": "^5.0.1",
        "tslib": "^2.8.1",
        "winston": "^3.19.0",
        "winston-daily-rotate-file": "^5.0.0"
    },
    "devDependencies": {
        "@types/bcrypt": "^6.0.0",
        "cross-env": "^10.1.0",
        "jest": "^30.2.0",
        "nodemon": "^3.1.10",
        "supertest": "^7.2.2"
    },
    "overrides": {
        "effect": "3.20.0"
    }
}
