# Copia este archivo como .env y rellena los valores
# Para desarrollo local: copia .env.local.example como .env

DATABASE_URL=postgresql://postgres:TU_PASSWORD@localhost:5432/astrostar?schema=public
PORT=4000

EMAIL_USER=tu_email@gmail.com
EMAIL_PASSWORD=tu_app_password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
EMAIL_SIMULATE_ON_FAILURE=false

JWT_SECRET=genera_uno_con_openssl_rand_hex_64
JWT_REFRESH_SECRET=genera_otro_con_openssl_rand_hex_64
JWT_ACCESS_EXPIRES_IN=30m
JWT_REFRESH_EXPIRES_IN=7d

FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:4000

NODE_ENV=development
LOG_LEVEL=info

CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

DISABLE_RSVP_JOB=false
